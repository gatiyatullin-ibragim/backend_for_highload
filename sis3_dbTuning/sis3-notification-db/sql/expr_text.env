CHANNEL="CASE WHEN (hashint8(g*3+1) & 2147483647) % 100 < 70 THEN 'push' WHEN (hashint8(g*3+1) & 2147483647) % 100 < 90 THEN 'email' WHEN (hashint8(g*3+1) & 2147483647) % 100 < 92 THEN 'sms' ELSE 'in_app' END"
STATUS="CASE WHEN (hashint8(g*5+2) & 2147483647) % 100 < 93 THEN 'delivered' WHEN (hashint8(g*5+2) & 2147483647) % 100 < 98 THEN 'sent' ELSE 'failed' END"
